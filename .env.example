# Copy to .env and fill in values
ADMIN_USERNAME=admin
# Generate: python3 -c "import hashlib; print(hashlib.sha256(b'your-password').hexdigest())"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# HTTPS 部署设为 1；本地 HTTP 开发保持 0
COOKIE_SECURE=0
# API Key for programmatic uploads (generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEY=

# Multi-file microsite storage and delivery
MICROSITE_DATA_DIR=/app/app/data/microsites
MICROSITE_MAX_FILES=100000
MICROSITE_MAX_TOTAL_BYTES=53687091200
MICROSITE_MAX_BLOB_BYTES=5368709120
MICROSITE_MAX_SOURCE_BYTES=2147483648
MICROSITE_RUNTIME_MAX_DOCUMENT_BYTES=1048576
MICROSITE_RUNTIME_MAX_VERSIONS=100
# Optional public data origin, e.g. https://assets.example.com
MICROSITE_PUBLIC_BASE_URL=
# Optional nginx internal location, e.g. /_protected_microsite_blobs
MICROSITE_ACCEL_PREFIX=
MICROSITE_CORS_ORIGIN=*
