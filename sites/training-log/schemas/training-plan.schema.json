{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Training plan",
  "description": "Maps ISO calendar dates to selected training identifiers and optional workout details.",
  "type": "object",
  "maxProperties": 3660,
  "$defs": {
    "trainingId": {
      "type": "string",
      "enum": [
        "chest",
        "back",
        "legs",
        "glutes",
        "biceps",
        "triceps",
        "shoulders",
        "core",
        "cardio",
        "rest"
      ]
    },
    "strengthDetail": {
      "type": "object",
      "properties": {
        "exercise": {
          "type": "string",
          "maxLength": 80
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "reps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "cardioDetail": {
      "type": "object",
      "properties": {
        "exercise": {
          "type": "string",
          "maxLength": 80
        },
        "averageHeartRate": {
          "type": "integer",
          "minimum": 30,
          "maximum": 250
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "note": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "strengthDetails": {
      "oneOf": [
        {
          "$ref": "#/$defs/strengthDetail"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/strengthDetail"
          }
        }
      ]
    },
    "cardioDetails": {
      "oneOf": [
        {
          "$ref": "#/$defs/cardioDetail"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/cardioDetail"
          }
        }
      ]
    },
    "details": {
      "type": "object",
      "properties": {
        "chest": {
          "$ref": "#/$defs/strengthDetails"
        },
        "back": {
          "$ref": "#/$defs/strengthDetails"
        },
        "legs": {
          "$ref": "#/$defs/strengthDetails"
        },
        "glutes": {
          "$ref": "#/$defs/strengthDetails"
        },
        "biceps": {
          "$ref": "#/$defs/strengthDetails"
        },
        "triceps": {
          "$ref": "#/$defs/strengthDetails"
        },
        "shoulders": {
          "$ref": "#/$defs/strengthDetails"
        },
        "core": {
          "$ref": "#/$defs/strengthDetails"
        },
        "cardio": {
          "$ref": "#/$defs/cardioDetails"
        }
      },
      "additionalProperties": false
    },
    "legacyEntry": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/trainingId"
      }
    },
    "detailedEntry": {
      "type": "object",
      "required": [
        "ids",
        "details"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/trainingId"
          }
        },
        "details": {
          "$ref": "#/$defs/details"
        },
        "locked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyEntry"
        },
        {
          "$ref": "#/$defs/detailedEntry"
        }
      ]
    }
  },
  "additionalProperties": false
}
