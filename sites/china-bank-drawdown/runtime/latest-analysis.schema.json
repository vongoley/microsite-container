{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "China Bank rolling drawdown analysis",
  "type": "object",
  "required": [
    "metadata",
    "metrics",
    "buy_references",
    "matrix",
    "ongoing_drawdown",
    "events"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "symbol",
        "decision_date_t",
        "first_trading_date",
        "latest_trading_date",
        "trading_day_count",
        "small_drawdown_pct",
        "short_gap_days",
        "generated_at"
      ],
      "properties": {
        "symbol": {"type": "string"},
        "decision_date_t": {"type": "string", "format": "date"},
        "first_trading_date": {"type": "string", "format": "date"},
        "latest_trading_date": {"type": "string", "format": "date"},
        "trading_day_count": {"type": "integer", "minimum": 1},
        "small_drawdown_pct": {"type": "number", "minimum": 0},
        "short_gap_days": {"type": "integer", "minimum": 1},
        "generated_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "required": [
        "raw_event_count",
        "included_event_count",
        "excluded_event_count",
        "arithmetic_mean_drawdown_pct",
        "trading_day_weighted_mean_drawdown_pct",
        "total_trading_day_weight"
      ],
      "properties": {
        "raw_event_count": {"type": "integer", "minimum": 0},
        "included_event_count": {"type": "integer", "minimum": 1},
        "excluded_event_count": {"type": "integer", "minimum": 0},
        "arithmetic_mean_drawdown_pct": {"type": "number", "minimum": 0},
        "trading_day_weighted_mean_drawdown_pct": {"type": "number", "minimum": 0},
        "total_trading_day_weight": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "buy_references": {
      "type": "object",
      "required": [
        "highest_close_through_t_minus_1",
        "highest_close_date",
        "arithmetic_mean_reference_price",
        "trading_day_weighted_reference_price",
        "buy_friction_pct",
        "sell_friction_pct",
        "expected_capital_gain_pct",
        "arithmetic_friction_adjusted",
        "weighted_friction_adjusted"
      ],
      "properties": {
        "highest_close_through_t_minus_1": {"type": "number", "exclusiveMinimum": 0},
        "highest_close_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "arithmetic_mean_reference_price": {"type": "number", "exclusiveMinimum": 0},
        "trading_day_weighted_reference_price": {"type": "number", "exclusiveMinimum": 0},
        "buy_friction_pct": {"type": "number", "minimum": 0},
        "sell_friction_pct": {"type": "number", "minimum": 0},
        "expected_capital_gain_pct": {"type": "number", "minimum": 0},
        "arithmetic_friction_adjusted": {"$ref": "#/$defs/priceReference"},
        "weighted_friction_adjusted": {"$ref": "#/$defs/priceReference"}
      },
      "additionalProperties": true
    },
    "matrix": {
      "type": "object",
      "required": ["short_small", "short_large", "long_small", "long_large"],
      "properties": {
        "short_small": {"type": "integer", "minimum": 0},
        "short_large": {"type": "integer", "minimum": 0},
        "long_small": {"type": "integer", "minimum": 0},
        "long_large": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ongoing_drawdown": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["peak_date", "peak_price", "trough_price", "drawdown_pct"],
          "properties": {
            "peak_date": {"type": "string"},
            "peak_price": {"type": "number", "exclusiveMinimum": 0},
            "trough_price": {"type": "number", "exclusiveMinimum": 0},
            "drawdown_pct": {"type": "number", "minimum": 0}
          },
          "additionalProperties": true
        }
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "peak_date",
          "peak_price",
          "trough_date",
          "trough_price",
          "drawdown_pct",
          "peak_to_trough_trading_days",
          "recovery_date",
          "included_in_averages"
        ],
        "properties": {
          "event_id": {"type": "integer", "minimum": 1},
          "peak_date": {"type": "string", "format": "date"},
          "peak_price": {"type": "number", "exclusiveMinimum": 0},
          "trough_date": {"type": "string", "format": "date"},
          "trough_price": {"type": "number", "exclusiveMinimum": 0},
          "drawdown_pct": {"type": "number", "minimum": 0},
          "peak_to_trough_trading_days": {"type": "integer", "minimum": 1},
          "recovery_date": {"type": "string", "format": "date"},
          "included_in_averages": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "priceReference": {
      "type": "object",
      "required": [
        "entry_limit_price",
        "all_in_cost_at_entry_limit",
        "exit_limit_price",
        "net_capital_gain_pct_at_exit_limit",
        "net_total_return_pct_including_dividend"
      ],
      "properties": {
        "entry_limit_price": {"type": "number", "exclusiveMinimum": 0},
        "all_in_cost_at_entry_limit": {"type": "number", "exclusiveMinimum": 0},
        "exit_limit_price": {"type": "number", "exclusiveMinimum": 0},
        "net_capital_gain_pct_at_exit_limit": {"type": "number"},
        "net_total_return_pct_including_dividend": {"type": "number"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
